<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for downloading verified GGUF models -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Custom permission for 3rd-party apps to bind to Local AI Core -->
    <permission
        android:name="${applicationId}.permission.BIND_LOCAL_AI_CORE"
        android:protectionLevel="normal"
        android:label="@string/perm_bind_local_ai_label"
        android:description="@string/perm_bind_local_ai_desc" />

    <uses-permission android:name="${applicationId}.permission.BIND_LOCAL_AI_CORE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- Optional vendor OpenCL driver used by LiteRT-LM's real GPU backend. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <!-- Optional Qualcomm FastRPC driver. Its presence alone is not proof of NPU compatibility. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System IPC Binder Service for Local AI Core -->
        <service
            android:name=".ipc.LocalAiCoreService"
            android:exported="${localAiExported}"
            android:permission="${applicationId}.permission.BIND_LOCAL_AI_CORE">
            <intent-filter>
                <action android:name="${applicationId}.ACTION_BIND_AI_CORE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Dedicated On-Device Inference Foreground Service -->
        <service
            android:name=".service.InferenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- System-wide AI Brain Action Activity (Process Text floating toolbar & Share) -->
        <activity
            android:name=".ipc.BrainTextActionActivity"
            android:label="Polish with Better Intelligence"
            android:theme="@style/Theme.MyApplication"
            android:exported="${localAiExported}">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="${applicationId}.ACTION_BRAIN_QUERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Zero-SDK ContentProvider for Cross-App AI Brain Queries & Shared RAG Memory -->
        <provider
            android:name=".ipc.AiBrainContentProvider"
            android:authorities="${applicationId}.provider"
            android:permission="${applicationId}.permission.BIND_LOCAL_AI_CORE"
            android:exported="${localAiExported}" />

    </application>

</manifest>
